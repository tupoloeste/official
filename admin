<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    :root{--red:#f8324b;--dark:#171717;--bg:#f5f6f8;--border:#e5e7eb}
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:#222}
    .wrap{max-width:980px;margin:auto;padding:16px}
    .card{background:#fff;border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:14px}
    h1,h2,h3{margin-top:0}
    .brand{display:flex;align-items:center;gap:10px;margin-bottom:16px}
    .mark{width:46px;height:46px;border-radius:50%;background:var(--red);color:#fff;display:grid;place-items:center;font-weight:900}
    input,select,textarea{width:100%;padding:11px;border:1px solid #d1d5db;border-radius:9px;margin:5px 0 11px}
    textarea{min-height:90px}
    button{border:0;background:var(--red);color:#fff;padding:10px 14px;border-radius:9px;font-weight:800;cursor:pointer}
    button.secondary{background:#333}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .menu{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
    .menu button{min-height:80px}
    .hidden{display:none!important}
    .msg{padding:10px;border-radius:8px;margin:10px 0;background:#fff0f3}
    .ok{background:#ecfdf3;color:#166534}
    .err{background:#fff0f3;color:#9f1239}
    .row{display:flex;gap:8px;flex-wrap:wrap}
    hr{border:0;border-top:1px solid #eee;margin:16px 0}
    @media(max-width:700px){.grid,.menu{grid-template-columns:1fr}}
  </style>
</head>
<body>
<div class="wrap">
  <div class="brand">
    <div class="mark">BTO</div>
    <div><strong>Barangay Tupol Oeste</strong><br><small>Encoder Portal</small></div>
  </div>

  <div id="loginCard" class="card">
    <h2>Login</h2>
    <label>Username</label>
    <input id="username" autocomplete="username">
    <label>Password</label>
    <input id="password" type="password" autocomplete="current-password"
           onkeydown="if(event.key==='Enter') login()">
    <button id="loginBtn" onclick="login()">Sign In</button>
    <div id="loginMsg"></div>
  </div>

  <div id="app" class="hidden">
    <div class="card">
      <div class="row" style="justify-content:space-between;align-items:center">
        <div><strong id="who"></strong><br><small id="role"></small></div>
        <button class="secondary" onclick="logout()">Logout</button>
      </div>
    </div>

    <div class="card">
      <h3>My Modules</h3>
      <div id="moduleMenu" class="menu"></div>
    </div>

    <div id="moduleArea"></div>
  </div>
</div>

<script>
let token = localStorage.getItem('btoToken') || '';
let me = null;

/*
 * IMPORTANT FIX:
 * Use google.script.run inside the Apps Script portal.
 * Do NOT fetch(location.href), because the rendered HTML runs on a
 * googleusercontent iframe URL and that returns HTML instead of JSON.
 */
function api(action, data = {}) {
  return new Promise((resolve) => {
    const payload = { action, token, data };

    if (action === 'login') {
      payload.username = data.username || '';
      payload.password = data.password || '';
    }

    google.script.run
      .withSuccessHandler((result) => {
        resolve(result || {success:false,message:'Empty server response.'});
      })
      .withFailureHandler((err) => {
        resolve({
          success:false,
          message:(err && err.message) ? err.message : String(err || 'Server error')
        });
      })
      .BTO_portalAction(payload);
  });
}

async function login(){
  const btn=document.getElementById('loginBtn');
  const msg=document.getElementById('loginMsg');
  btn.disabled=true;
  btn.textContent='Signing in...';
  msg.innerHTML='';

  const r=await api('login',{
    username:document.getElementById('username').value.trim(),
    password:document.getElementById('password').value
  });

  btn.disabled=false;
  btn.textContent='Sign In';

  if(!r.success){
    msg.innerHTML='<div class="msg err">'+esc(r.message)+'</div>';
    return;
  }

  token=r.token;
  me=r.user;
  localStorage.setItem('btoToken',token);
  renderApp();
}

async function logout(){
  await api('logout');
  localStorage.removeItem('btoToken');
  token='';
  me=null;
  document.getElementById('app').classList.add('hidden');
  document.getElementById('loginCard').classList.remove('hidden');
  document.getElementById('password').value='';
}

function hasModule(name){
  if(!me) return false;
  if(['SUPER_ADMIN','ADMIN'].includes(me.role)) return true;

  const mods=(me.assignedModules||'')
    .split(',')
    .map(x=>x.trim().toUpperCase())
    .filter(Boolean);

  return mods.includes('ALL') || mods.includes(name.toUpperCase());
}

function renderApp(){
  document.getElementById('loginCard').classList.add('hidden');
  document.getElementById('app').classList.remove('hidden');

  document.getElementById('who').textContent=me.fullName || me.username;
  document.getElementById('role').textContent=me.role;

  const items=[];
  if(hasModule('OFFICIALS')) items.push(['Officials','officials']);
  if(hasModule('COMMITTEE_ASSIGNMENTS')) items.push(['Committee Assignments','assignments']);
  if(hasModule('BARANGAY_STATISTICS')) items.push(['Barangay Statistics','stats']);
  if(hasModule('LIVESTOCK')) items.push(['Livestock Statistics','livestock']);
  if(hasModule('CONTENT') || (me.assignedModules||'').includes('COM-'))
    items.push(['Announcements & Activities','content']);
  if(['SUPER_ADMIN','ADMIN'].includes(me.role)) items.push(['Users','users']);

  document.getElementById('moduleMenu').innerHTML =
    items.map(i=>`<button onclick="openModule('${i[1]}')">${i[0]}</button>`).join('');

  document.getElementById('moduleArea').innerHTML='';
}

async function restore(){
  if(!token) return;

  const r=await api('getMe');
  if(r.success){
    me=r.user;
    renderApp();
  }else{
    localStorage.removeItem('btoToken');
    token='';
  }
}

async function openModule(name){
  document.getElementById('moduleArea').innerHTML='<div class="card">Loading...</div>';
  if(name==='stats') return loadStats();
  if(name==='livestock') return loadLivestock();
  if(name==='content') return contentForm();
  if(name==='officials') return officialsForm();
  if(name==='assignments') return assignmentForm();
  if(name==='users') return usersForm();
}

async function loadStats(){
  const r=await api('getBarangayStats');
  if(!r.success){showModuleError(r.message);return}

  document.getElementById('moduleArea').innerHTML =
    `<div class="card"><h2>Barangay Statistics</h2>${r.data.map(x=>`
      <label>${esc(x.Label)}</label>
      <input id="s_${x['Stat Key']}" value="${esc(x.Value)}" type="number">
      <button onclick="saveStat('${x['Stat Key']}')">Save ${esc(x.Label)}</button>
      <hr>`).join('')}</div>`;
}

async function saveStat(key){
  const value=document.getElementById('s_'+key).value;
  const r=await api('saveBarangayStat',{
    statKey:key,
    value,
    asOfDate:new Date().toISOString().slice(0,10)
  });
  alert(r.success?'Saved':r.message);
}

async function loadLivestock(){
  const r=await api('getLivestockStats');
  if(!r.success){showModuleError(r.message);return}

  document.getElementById('moduleArea').innerHTML =
    `<div class="card"><h2>Livestock Statistics</h2>${r.data.map(x=>`
      <label>${esc(x.Animal)}</label>
      <input id="l_${x['Livestock Key']}" value="${esc(x.Count)}" type="number">
      <button onclick="saveLivestock('${x['Livestock Key']}')">Save ${esc(x.Animal)}</button>
      <hr>`).join('')}</div>`;
}

async function saveLivestock(key){
  const count=document.getElementById('l_'+key).value;
  const r=await api('saveLivestockStat',{
    livestockKey:key,
    count,
    asOfDate:new Date().toISOString().slice(0,10)
  });
  alert(r.success?'Saved':r.message);
}

function contentForm(){
  document.getElementById('moduleArea').innerHTML=`
    <div class="card">
      <h2>Add Announcement / Activity</h2>

      <label>Type</label>
      <select id="cType">
        <option>ANNOUNCEMENT</option>
        <option>ACTIVITY</option>
      </select>

      <label>Title</label>
      <input id="cTitle">

      <div class="grid">
        <div><label>Date</label><input id="cDate" type="date"></div>
        <div><label>Time</label><input id="cTime" type="time"></div>
      </div>

      <label>Venue</label>
      <input id="cVenue">

      <label>Committee ID</label>
      <input id="cCommittee" placeholder="Example: COM-001">

      <label>Description</label>
      <textarea id="cDesc"></textarea>

      <label>Featured Photo</label>
      <input id="cPhoto" type="file" accept="image/*">

      <button onclick="saveContent()">Save & Publish</button>
    </div>`;
}

async function saveContent(){
  let photoUrl='';
  const file=document.getElementById('cPhoto').files[0];

  if(file){
    const base64=await fileToBase64(file);
    const u=await api('uploadBase64',{
      fileName:file.name,
      mimeType:file.type,
      base64
    });

    if(!u.success){alert(u.message);return}
    photoUrl=u.url;
  }

  const r=await api('saveContent',{
    type:document.getElementById('cType').value,
    title:document.getElementById('cTitle').value,
    eventDate:document.getElementById('cDate').value,
    time:document.getElementById('cTime').value,
    venue:document.getElementById('cVenue').value,
    committeeId:document.getElementById('cCommittee').value,
    description:document.getElementById('cDesc').value,
    featuredPhotoUrl:photoUrl,
    status:'PUBLISHED'
  });

  alert(r.success?'Published':r.message);
}

function officialsForm(){
  document.getElementById('moduleArea').innerHTML=`
    <div class="card">
      <h2>Add / Update Official</h2>

      <label>Official ID (leave blank for new)</label>
      <input id="oId">

      <label>Full Name</label>
      <input id="oName">

      <label>Position</label>
      <input id="oPosition">

      <label>Group</label>
      <select id="oGroup">
        <option>BARANGAY</option>
        <option>SK</option>
        <option>TANOD</option>
        <option>STAFF</option>
      </select>

      <label>Contact Number (optional)</label>
      <input id="oContact">

      <label>Status</label>
      <select id="oStatus">
        <option>ACTIVE</option>
        <option>INACTIVE</option>
      </select>

      <label>Photo</label>
      <input id="oPhoto" type="file" accept="image/*">

      <button onclick="saveOfficial()">Save Official</button>
    </div>`;
}

async function saveOfficial(){
  let photoUrl='';
  const file=document.getElementById('oPhoto').files[0];

  if(file){
    const base64=await fileToBase64(file);
    const u=await api('uploadBase64',{
      fileName:file.name,
      mimeType:file.type,
      base64
    });
    if(!u.success){alert(u.message);return}
    photoUrl=u.url;
  }

  const r=await api('saveOfficial',{
    officialId:document.getElementById('oId').value,
    fullName:document.getElementById('oName').value,
    position:document.getElementById('oPosition').value,
    group:document.getElementById('oGroup').value,
    contactNumber:document.getElementById('oContact').value,
    status:document.getElementById('oStatus').value,
    photoUrl
  });

  alert(r.success?'Saved: '+r.officialId:r.message);
}

function assignmentForm(){
  document.getElementById('moduleArea').innerHTML=`
    <div class="card">
      <h2>Committee Assignment</h2>

      <label>Official ID</label>
      <input id="aOfficial" placeholder="Example: OFF-00001">

      <label>Committee ID</label>
      <input id="aCommittee" placeholder="Example: COM-001">

      <label>Role</label>
      <select id="aRole">
        <option>Chairperson</option>
        <option>Vice Chairperson</option>
        <option>Member</option>
      </select>

      <label>Status</label>
      <select id="aStatus">
        <option>ACTIVE</option>
        <option>INACTIVE</option>
      </select>

      <button onclick="saveAssignment()">Save Assignment</button>
    </div>`;
}

async function saveAssignment(){
  const r=await api('saveCommitteeAssignment',{
    officialId:document.getElementById('aOfficial').value,
    committeeId:document.getElementById('aCommittee').value,
    role:document.getElementById('aRole').value,
    status:document.getElementById('aStatus').value
  });

  alert(r.success?'Saved: '+r.assignmentId:r.message);
}

function usersForm(){
  document.getElementById('moduleArea').innerHTML=`
    <div class="card">
      <h2>Create / Update User</h2>

      <label>User ID (leave blank for new)</label>
      <input id="uId">

      <label>Username</label>
      <input id="uUsername">

      <label>Password (required for new user)</label>
      <input id="uPassword" type="password">

      <label>Full Name</label>
      <input id="uName">

      <label>Role</label>
      <select id="uRole">
        <option>SUPER_ADMIN</option>
        <option>ADMIN</option>
        <option>KAGAWAD</option>
        <option>ENCODER</option>
        <option>VIEWER</option>
      </select>

      <label>Assigned Modules / Committee IDs (comma-separated)</label>
      <input id="uModules" placeholder="Example: LIVESTOCK,COM-001,COM-003">

      <label>Status</label>
      <select id="uStatus">
        <option>ACTIVE</option>
        <option>INACTIVE</option>
      </select>

      <button onclick="saveUser()">Save User</button>
    </div>`;
}

async function saveUser(){
  const r=await api('saveUser',{
    userId:document.getElementById('uId').value,
    username:document.getElementById('uUsername').value,
    password:document.getElementById('uPassword').value,
    fullName:document.getElementById('uName').value,
    role:document.getElementById('uRole').value,
    assignedModules:document.getElementById('uModules').value,
    status:document.getElementById('uStatus').value
  });

  alert(r.success?'Saved: '+r.userId:r.message);
}

function showModuleError(message){
  document.getElementById('moduleArea').innerHTML =
    '<div class="card"><div class="msg err">'+esc(message)+'</div></div>';
}

function fileToBase64(file){
  return new Promise((resolve,reject)=>{
    const reader=new FileReader();
    reader.onload=()=>resolve(String(reader.result).split(',')[1]||'');
    reader.onerror=reject;
    reader.readAsDataURL(file);
  });
}

function esc(v){
  return String(v??'').replace(/[&<>"']/g,m=>({
    '&':'&amp;',
    '<':'&lt;',
    '>':'&gt;',
    '"':'&quot;',
    "'":'&#39;'
  }[m]));
}

restore();
</script>
</body>
</html>
